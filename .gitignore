.venv/
__pycache__/
*.pyc
*.pt
*.onnx
# Evidence is examination output, never source. The directory itself is tracked
# so that a fresh clone satisfies the phase-0 layout gate.
evidence/*
!evidence/.gitkeep

# Corpus and source video are large and regenerable from train/build_corpus.py.
data/authentic/*
data/corpus/*
!data/authentic/.gitkeep
!data/corpus/.gitkeep

web/vendor/*.js
!web/.gitkeep

.pytest_cache/
.ruff_cache/

# Transfer archives used to carry checkpoints between the training and examination
# workstations. The checkpoints themselves are already ignored above; these are the
# containers they travelled in, and one of them is past GitHub's file size limit.
*.zip

# The static bundle Vercel serves is assembled by deploy/build_public.py at build time.
public/
